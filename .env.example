# Copy this file to .env and fill in the values. The server reads .env on startup.
# A variable already set in the shell is left unchanged.

PORT=4173

# Enquiry mail. Every form on the page is sent here.
# Gmail: turn on 2-step verification, then create an app password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASS=the 16 character app password
# SMTP_FROM=you@gmail.com
# SMTP_TO=the inbox that should receive enquiries

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=

# Optional alternatives. SMTP is used first when the fields above are filled.
# LEAD_WEBHOOK_URL=https://example.com/hooks/leads
# LEAD_WEBHOOK_TOKEN=
# LEAD_LOCAL_STORE=true
# LEAD_STORE_PATH=data/leads/enquiries.jsonl
